; Godot 프로젝트 설정 파일. 에디터에서 바꾸면 자동으로 갱신됩니다.

config_version=5

[application]

config/name="Little Haven"
config/description="펫 수집 + 조합 + 작업장 경영 시뮬레이션 (미니판)"
config/version="0.7.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DataDB="*res://scripts/autoload/data_db.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
PetPortraits="*res://scenes/pets/pet_portraits.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/NanumGothic-Regular.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
